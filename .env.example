# CLI only. Never commit actual keys; use --env-file .env or process environment.
ANTHROPIC_API_KEY=replace_with_your_private_api_key
# Default model is pinned in scientific/model-config.js. Overrides are recorded.
# POWER_AGENT_MODEL=claude-haiku-4-5-20251001
# Local non-root Linux opt-out must be explicit in the process environment;
# it is unavailable when NODE_ENV=production. See README for restrictions.

# Optional alternate primary-source search when Tavily is unavailable
FIRECRAWL_API_KEY=

# Current optional API runtime role mapping
POWER_AGENT_MODEL=claude-sonnet-5-5
POWER_AGENT_ROUTING_MODEL=claude-haiku-5-5
# Hosted-only direct access; private history still requires verified ownership
POWER_AGENT_ACCESS_MODE=public
